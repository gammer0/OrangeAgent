"""fluid 项目的常量表。

这里只放**纯数值常量**。物理层（core.py）与界面层（下一轮 main.py）共用本模块，
且本项目约定：除界面文件外一律不 import pygame。

参数含义见 README.md 的「物理模型说明」。
"""

from __future__ import annotations

# ---------------------------------------------------------------- 世界与窗口
WORLD_WIDTH = 900            # 世界宽（像素）
WORLD_HEIGHT = 600           # 世界高（像素）
PANEL_WIDTH = 220            # 右侧信息面板宽（下一轮界面用）
FPS = 60                     # 渲染目标帧率
PHYSICS_DT = 1.0 / 60.0      # 固定物理步长（秒）
MAX_SUBSTEPS = 3             # 单帧最多补几个物理子步（防止卡顿后追帧爆炸）
MAX_PARTICLES = 3000         # 粒子上限

# ------------------------------------------------------------ 粒子与核函数
PARTICLE_RADIUS = 6.0                  # 单个水粒子的名义半径（像素）
REST_SPACING = 2.0 * PARTICLE_RADIUS   # 静止（互不重叠）时的粒子中心距
SMOOTHING_RADIUS = 2.5 * REST_SPACING  # 核函数支撑半径 h
CELL_SIZE = SMOOTHING_RADIUS           # 空间网格边长取 h，3x3 邻域即可覆盖全部邻居
UNIT_MASS = 1.0                        # 单个粒子质量（质量守恒观测用）

# ---------------------------------------------------------------- 密度约束
CONSTRAINT_ITERATIONS = 4     # 每个 step 的密度约束迭代次数（规范要求 >= 3）
RELAXATION = 1.0              # 每次迭代的位置修正松弛系数（1.0 = 全量修正）
MAX_CORRECTION_FACTOR = 0.25  # 单次迭代单粒子位移上限 = 该系数 x REST_SPACING
DENSITY_EPSILON = 1e-6        # lambda 分母的数值保护项

# ------------------------------------------------------------ 外力与时间积分
GRAVITY = 900.0         # 重力加速度（像素/秒^2），方向 +y
DAMPING = 0.99          # 每步速度阻尼系数（保留惯性，规范建议 0.98~0.995）
MAX_DT = 1.0 / 30.0     # 单个 step 允许的最大时间步，防御异常大的 dt
MAX_SPEED = 6000.0      # 速度上限（像素/秒），只用于数值保护，不参与正常演化
# XSPH 粘性系数：只耗散粒子间的**相对**速度（不是把速度乘 0），
# 用来压掉位置约束带来的抖动，让液体真正静下来
VISCOSITY = 0.10

# ------------------------------------------------------------------ 碰撞
COLLISION_MARGIN = PARTICLE_RADIUS   # 粒子的碰撞半径：中心与墙/固体面至少这么远

# ------------------------------------------------------------------ 颜色
COLOR_BG = (16, 20, 28)
COLOR_WATER = (64, 156, 255)
COLOR_WATER_EDGE = (130, 200, 255)
COLOR_SOLID = (92, 96, 104)
COLOR_SOLID_EDGE = (140, 146, 156)
COLOR_TEXT = (226, 232, 240)
COLOR_PANEL = (24, 30, 40)

# ---------------------------------------------------------------- 默认场景
DEFAULT_SPAWN_RADIUS = 24.0   # 画刷半径
DEFAULT_SPAWN_COUNT = 6       # 每帧画刷落下的粒子数
