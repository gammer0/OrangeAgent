# ==========================================================
# LLM 配置模板 —— 复制为 .env 后填入真实值
# 用法：Copy-Item .env.example .env
# ==========================================================

# 密钥：https://platform.deepseek.com 申请
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI 兼容端点
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：deepseek-flash | deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
