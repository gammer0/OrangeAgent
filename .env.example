# ==========================================================
# LLM 配置模板 —— 复制为 .env 后填入真实值
# 用法：Copy-Item .env.example .env
# ==========================================================

# 密钥：https://platform.deepseek.com 申请
# 只从环境变量读取，代码中不出现明文；进程环境变量优先级高于本文件
DEEPSEEK_API_KEY=sk-your-key-here

# OpenAI 兼容端点（尾部斜杠可省略）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型：deepseek-chat | deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# 生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
